APP_NAME="Socal Mediation Center"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL=http://localhost
# Destination shown after a successful SoCal payment. Leave blank to hide the button.
SOCAL_REDIRECT_URL=
# Destination shown after a successful Legal Consultation payment. Leave blank to hide the button.
LEGAL_REDIRECT_URL=
APP_TIMEZONE=America/Los_Angeles
BOOKING_TIMEZONE=America/Los_Angeles
BOOKING_DAY_START=09:00
BOOKING_DAY_END=17:00
# Optional fallback phone number shown in emails for phone consultations.
CONSULTATION_PHONE=
# Optional fallback location shown in emails for offline/in-person consultations.
CONSULTATION_LOCATION_ADDRESS=
# App-specific phone/location values override the common fallbacks above.
SOCAL_CONSULTATION_PHONE=
SOCAL_CONSULTATION_LOCATION_ADDRESS=
LEGAL_CONSULTATION_PHONE=
LEGAL_CONSULTATION_LOCATION_ADDRESS=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=socal_mediation_center
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Enables real Converge payment-link generation. Keep false when using simulation.
CONVERGE_ENABLED=false
# Selects sandbox or production endpoints.
CONVERGE_MODE=sandbox
# Converge sandbox API and Hosted Payment Page host.
CONVERGE_SANDBOX_BASE_URL=https://api.demo.convergepay.com
# Converge production API and Hosted Payment Page host.
CONVERGE_PRODUCTION_BASE_URL=https://api.convergepay.com
# Elavon-assigned 6 or 7-digit Converge Account ID (AID), not the 10-digit merchant ID.
CONVERGE_ACCOUNT_ID=
# Converge API user identifier.
CONVERGE_USER_ID=
# Converge API PIN; keep this secret.
CONVERGE_PIN=
# Optional XML API transaction-query credentials. Defaults to the HPP credentials above.
CONVERGE_XML_ACCOUNT_ID=
CONVERGE_XML_USER_ID=
CONVERGE_XML_PIN=
# Enables scheduled verification of pending Converge payments.
CONVERGE_PAYMENT_SYNC_ENABLED=false
# Minutes between scheduled payment-verification runs.
# Only pending payments created within this many days are checked.
CONVERGE_PAYMENT_SYNC_LOOKBACK_DAYS=30
# Maximum pending payments checked during one scheduled run.
CONVERGE_PAYMENT_SYNC_BATCH_SIZE=50
# Maximum time in seconds for each Converge HTTP request.
CONVERGE_HTTP_TIMEOUT_SECONDS=90
# Optional legacy browser-return endpoint. Payment reconciliation does not depend on it.
CONVERGE_RETURN_URL="${APP_URL}/api/v1/payments/converge/return"

# Enables the non-production payment simulation API when Converge is disabled.
PAYMENT_SIMULATION_ENABLED=false
# Secret required in the X-Payment-Simulation-Key request header.
PAYMENT_SIMULATION_KEY=

ZOOM_MEETINGS_ENABLED=false
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_OAUTH_BASE_URL=https://zoom.us
ZOOM_BASE_URL=https://api.zoom.us/v2
ZOOM_JOIN_BASE_URL=https://zoom.us

OUTLOOK_SYNC_ENABLED=false
# Minutes between scheduled Outlook calendar sync runs.
OUTLOOK_SYNC_INTERVAL_MINUTES=15
OUTLOOK_TENANT_ID=
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_LOGIN_BASE_URL=https://login.microsoftonline.com
OUTLOOK_USER_ID=
OUTLOOK_CALENDAR_ID=
OUTLOOK_BASE_URL=https://graph.microsoft.com/v1.0
